DATABASE_URL=postgres://frota:frota@localhost:5433/frota
PORT=3200

# Autenticação
JWT_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres
# Opcional: cria o primeiro admin se a tabela users estiver vazia
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-esta-senha

# Notificação de vencimentos por e-mail (opcional; desativada sem SMTP_HOST, SMTP_FROM e NOTIFY_TO)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=frota@exemplo.com
NOTIFY_TO=gestor@exemplo.com
NOTIFY_DAYS=30
NOTIFY_HOUR=8

# Apenas para o docker compose (portas expostas no host)
API_PORT=3100
DB_PORT=5433
